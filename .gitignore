# macOS
.DS_Store

# Xcode — user-specific state only. The project files themselves ARE committed:
# Xcode 16 synchronized folder groups keep project.pbxproj stable and mergeable.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/

# Swift Package Manager build products & per-user package state
.build/
.swiftpm/

# Python pipeline (pipeline/). uv.lock IS committed — it pins spaCy + the model wheel.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.coverage

# Pipeline working files. candidates.json, rejected.json and responses/ ARE committed:
# the candidate ranks are what the pasted responses answer, and regenerating a reply
# by hand is the expensive step. Everything below is derived from those in one command.
pipeline/work/*/prompts/
pipeline/work/*/retry/*.md
pipeline/work/*/retry/targets.json
pipeline/work/*/drops.json
# The UDPipe model is 25 MB of binary, pinned by checksum and fetched with
# `packgen models <lang>`. Never committed.
pipeline/work/models/
# ...but retry/answers/ is generated content, not a regenerable prompt: keep it.
!pipeline/work/*/retry/answers/

# Tooling / build caches
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
timeline.xctimeline

# Per-developer editor/agent rule files. A local plugin regenerates these on
# session start with the same personal prose-style rules in six places; none of
# them carry project content. AGENTS.md IS committed — it points at CLAUDE.md.
.clinerules/
.cursor/
.opencode/
.windsurf/
.github/copilot-instructions.md

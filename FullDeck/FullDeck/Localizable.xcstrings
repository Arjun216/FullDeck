{
  "sourceLanguage": "en",
  "strings": {
    "%@, active language": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, idioma activo"
          }
        }
      }
    },
    "%@, locked": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, bloqueado"
          }
        }
      }
    },
    "%lld": {
      "comment": "LearningProgressView's raw learned-count readout; no translation needed."
    },
    "%lld of %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld"
          }
        }
      }
    },
    "%lld of %lld words learned": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld palabras aprendidas"
          }
        }
      }
    },
    "Add another language — $0.99": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir otro idioma — 0,99 $"
          }
        }
      }
    },
    "All 1000 words. One payment, yours for good.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las 1000 palabras. Un solo pago, tuyas para siempre."
          }
        }
      }
    },
    "Audio unavailable on this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio no disponible en este dispositivo."
          }
        }
      }
    },
    "Card %lld of %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjeta %lld de %lld"
          }
        }
      }
    },
    "Choose a language": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un idioma"
          }
        }
      }
    },
    "Couldn't complete the purchase. You haven't been charged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la compra. No se te ha cobrado."
          }
        }
      }
    },
    "Couldn't load the available languages.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los idiomas disponibles."
          }
        }
      }
    },
    "Couldn't load this language.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar este idioma."
          }
        }
      }
    },
    "Couldn't load your progress.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar tu progreso."
